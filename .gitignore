# Si algún día querés versionar la spec y el plan, borrá estas cuatro líneas.
1.construccion/
2.especificacion/
3.clarificacion/
4.plan/

# ─── Videos institucionales pesados ──────────────────────────────────────────
# 4 archivos de 26–38 MB (124 MB en total) que ya están en el servidor y no
# cambian nunca. Mantenerlos afuera baja el repo de ~185 MB a ~60 MB.
# Si alguna vez se reemplaza uno, se sube a mano por FTP.
assets/videos/*.mp4


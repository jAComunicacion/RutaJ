# RUTA J — datos de conexión FTP a Neolo
#
# Copiá este archivo como  deploy/.env  y completá los valores.
# deploy/.env está en .gitignore: NUNCA se sube a GitHub.

FTP_HOST=ftp.rutaj.com.ar
FTP_USER=
FTP_PASSWORD=

# Puerto: 21 es FTP normal. Si Neolo te dio SFTP, este script no sirve — avisame.
FTP_PORT=21

# true = FTPS (FTP sobre TLS, la contraseña viaja cifrada). Probá primero true;
# si Neolo lo rechaza, poné false.
FTP_SECURE=true

# Carpeta raíz del sitio en el servidor. En Neolo suele ser /public_html
FTP_REMOTE_ROOT=/public_html
